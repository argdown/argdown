{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "./src",
    "plugins": [{ "name": "typescript-workspace-plugin" }],
    "moduleResolution": "node" ,
    "typeRoots": [
      "types",
      "node_modules/@types"
        ] ,
    "allowSyntheticDefaultImports": true ,
    "esModuleInterop": true
  },
  "exclude": ["types", "node_modules", "dist", "test"]
}
