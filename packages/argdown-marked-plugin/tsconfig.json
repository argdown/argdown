{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "plugins": [{ "name": "typescript-workspace-plugin" }],
    "moduleResolution": "node" ,
    "types": [
      "mocha",
      "node"
    ],
    "allowSyntheticDefaultImports": true ,
    "esModuleInterop": true
  },
  "exclude": ["types", "node_modules", "dist", "dist-esm", "test"]
}
