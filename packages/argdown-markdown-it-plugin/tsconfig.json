{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "moduleResolution": "node",

    /* Extra */
    "plugins": [{ "name": "typescript-workspace-plugin" }],
    "types": ["mocha", "node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "types", "dist", "test"]
}
