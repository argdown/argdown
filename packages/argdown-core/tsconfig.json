{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2022",
    "esModuleInterop": true,
    "plugins": [{ "name": "typescript-workspace-plugin" }],
    "moduleResolution": "node" ,
    "typeRoots": [
      "types",
      "node_modules/@types",
      "../../node_modules/@types",
      "../../types"
    ] ,
    "types": ["mocha", "node"],                       
    "allowSyntheticDefaultImports": true ,
  },
  "exclude": ["types", "node_modules", "dist", "dist-esm", "test"]
}
