{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "./src",
    "moduleResolution": "node",
    "typeRoots": [
      "types",
      "node_modules/@types",
      "../../node_modules/@types",
      "../../types"
    ],

    /* Extra */
    "plugins": [{ "name": "typescript-workspace-plugin" }],
    "types": ["mocha", "node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "exclude": ["types", "node_modules", "dist", "dist-esm", "test"]
}
