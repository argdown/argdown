{
  "name": "@argdown/language-server",
  "description": "Language Server for the Argdown argumentation syntax.",
  "version": "1.8.0",
  "author": "Christian Voigt",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">= 22.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/argdown/argdown/tree/master/packages/argdown-language-server"
  },
  "scripts": {
    "build": "npm run clean && tsc -p .",
    "clean": "rimraf \"dist/*\" --glob",
    "watch": "tsc -w -p .",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@argdown/core": "workspace:^",
    "@argdown/node": "workspace:^",
    "@types/node": "^22.15.24",
    "@vitest/expect": "^4.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.1.0"
  },
  "packageManager": "yarn@4.9.4"
}
