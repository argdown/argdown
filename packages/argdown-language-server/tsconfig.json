{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNEXT",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "./src",
    "moduleResolution": "node",

    /* Extra */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "plugins": [{ "name": "typescript-workspace-plugin" }],

  },
  "exclude": ["types", "node_modules", "dist", "dist-esm", "test"]
}
