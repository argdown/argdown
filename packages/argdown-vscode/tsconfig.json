{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES6",
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "node",
    "typeRoots": ["./types", "./node_modules/@types"],

    /* Extra */
    "lib": ["es6", "es2015.promise", "dom", "es2023"],
    "alwaysStrict": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
